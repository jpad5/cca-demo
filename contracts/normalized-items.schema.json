{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item Normalizer output",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": [
              "string",
              "number"
            ]
          },
          "displayName": {
            "type": "string"
          },
          "brand": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": "number"
          },
          "category": {
            "type": "string",
            "enum": [
              "Electronics",
              "Appliances",
              "Furniture",
              "Bedding & Textiles",
              "Clothing & Footwear",
              "Kitchenware",
              "Jewelry",
              "Other"
            ]
          },
          "searchQuery": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "displayName",
          "quantity",
          "category"
        ]
      }
    }
  },
  "required": [
    "items"
  ]
}
