{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Depreciation rule set payload",
  "type": "object",
  "properties": {
    "ruleSetName": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "effectiveStart": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "disclaimer": {
      "type": "string"
    },
    "highValueThresholdCAD": {
      "type": "number"
    },
    "reviewConfidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedRetailerHosts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "annualRate": {
            "type": "number"
          },
          "maxRate": {
            "type": "number"
          },
          "specialty": {
            "type": "boolean"
          }
        },
        "required": [
          "category",
          "annualRate",
          "maxRate",
          "specialty"
        ]
      }
    }
  },
  "required": [
    "ruleSetName",
    "version",
    "highValueThresholdCAD",
    "allowedRetailerHosts",
    "categories"
  ]
}
